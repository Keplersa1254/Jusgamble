# ─────────────────────────────────────────────────────────────
#  Jusgamble — Discord bot configuration (template)
#  Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#  Then edit `.env`, and run: npm start
#  NOTE: `.env` is gitignored — never commit your real token.
# ─────────────────────────────────────────────────────────────

# Discord Bot Token — https://discord.com/developers/applications
#   Applications → your bot → "Bot" tab → "Reset Token" → copy it here.
#   REQUIRED. The bot will refuse to start without it.
DISCORD_TOKEN=your_bot_token_here

# Application (Client) ID — same dev portal, "General Information" tab.
#   REQUIRED. Used to register slash commands.
CLIENT_ID=your_application_id_here

# MongoDB Atlas connection string — REQUIRED.
#   https://cloud.mongodb.com → Database → Connect → Drivers → Node.js → copy URI.
#   Replace <username>, <password>, and cluster0.xxxxx with your real values.
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jusgamble?retryWrites=true&w=majority

# OPTIONAL — restrict slash-command registration to a SINGLE server (guild)
# for instant updates while testing. Uncomment to enable:
#   GUILD_ID=your_server_id_here
# If absent, commands are registered globally (can take ~1 hour to appear).


# NOTE: Economy/game tuning (starting balance, daily rewards, blackjack TTL)
# intentionally live as constants in code (games/balancemanager.js and
# games/blackjackstore.js), NOT here — so rule changes stay visible and
# reviewable in git history.

# All user data (balances, progress, active games) is persisted to MongoDB Atlas
# via the DATABASE_URL above.